# Server Configuration
PORT=3000
WEBSOCKET_PORT=3001
ENVIRONMENT=development

# LLM Provider Configuration
# Choose between: gemini, openrouter
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Configuration (Legacy compatible with Gemini service)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Sheets Logging
GOOGLE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# SMTP Confirmation Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_SECURE=false
NOTIFICATION_EMAIL_FROM=claims@meridianinsurance.com
NOTIFICATION_EMAIL_TO=customer@example.com

