%% ----------------------------------------------------------------------------
%% 4. REQUEST FLOW & SEQUENCE DIAGRAM
%% ----------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Caller
    participant Retell as Retell AI Platform
    participant Server as Railway WS Server (server.ts)
    participant CM as ConversationManager
    participant Gemini as Gemini 2.5 Flash Lite
    participant SheetsResend as Google Sheets & Resend Email

    Caller->>Retell: 1. Dial / Initiate Call
    Retell->>Server: 2. WS Connect & call_details
    Server-->>Retell: 3. Greeting ("Before we begin, are you safe?")
    Caller->>Retell: 4. "Yes safe. Policy MMI-10234 Arjun Rao."
    Retell->>Server: 5. response_required
    Server->>CM: 6. handleUserMessage()
    CM->>Gemini: 7. extract(userMessage, state) [SSE Stream]
    Gemini-->>CM: 8. Extracted Slots + Natural Response
    CM-->>Server: 9. Verified Policy & Response Text
    Server-->>Retell: 10. response { content, content_complete }
    
    Note over CM, SheetsResend: ASYNCHRONOUS NON-BLOCKING PERSISTENCE
    par Async Log
        CM->>SheetsResend: 11. Async log() -> Append Google Sheet Row
    and Async Mail
        CM->>SheetsResend: 12. Async sendMail() -> claims@aurallon.com
    end

%% ----------------------------------------------------------------------------
%% 5. FINITE STATE MACHINE (FSM)
%% ----------------------------------------------------------------------------
stateDiagram-v2
    [*] --> safety_check : Call Setup

    safety_check --> escalation : Injury / Severe Incident
    safety_check --> verification : Caller Safe

    state verification {
        [*] --> check_policy
        check_policy --> verified : Policy + Name Match
        check_policy --> callback_offer : Attempts >= 2
    }

    verification --> collecting_details : Verified
    verification --> callback_offer : Verification Failed

    collecting_details --> clarifying : Invalid Reg / Ambiguous
    clarifying --> collecting_details : Clarified Input

    collecting_details --> recommending_services : All Required Fields Collected

    recommending_services --> completed : Services Handled
    escalation --> completed : Emergency Advisory
    callback_offer --> completed : Callback Logged

    completed --> [*] : Terminated

