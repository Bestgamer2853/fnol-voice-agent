%% ----------------------------------------------------------------------------
%% DIAGRAM 3: END-TO-END SEQUENCE & ASYNC PERSISTENCE
%% ----------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Caller
    participant Retell as Retell AI Platform
    participant Server as Railway WS Server (server.ts)
    participant CM as ConversationManager
    participant Gemini as Gemini 2.5 Flash Lite
    participant SheetsResend as Google Sheets & Resend Email

    Caller->>Retell: 1. Inbound Phone Call
    Retell->>Server: 2. WS Connect & call_details
    Server-->>Retell: 3. Spoken Greeting ("Are you safe?")
    Caller->>Retell: 4. "Yes safe. Policy MMI-10234 Arjun."
    Retell->>Server: 5. response_required
    Server->>CM: 6. handleUserMessage()
    CM->>Gemini: 7. extract(userMessage, state) [SSE]
    Gemini-->>CM: 8. Extracted Slots + Spoken Text
    CM-->>Server: 9. Verified Policy & Response Text
    Server-->>Retell: 10. response { content } (Audio Plays)
    
    Note over CM, SheetsResend: ASYNCHRONOUS NON-BLOCKING PERSISTENCE
    par Async Log
        CM->>SheetsResend: 11. Promise.resolve -> claimLogger.log()
    and Async Mail
        CM->>SheetsResend: 12. Promise.resolve -> sendClaimConfirmation()
    end

%% ----------------------------------------------------------------------------
%% DIAGRAM 4: FINITE STATE MACHINE (FSM) & COMPLIANCE ENGINE
%% ----------------------------------------------------------------------------
stateDiagram-v2
    [*] --> safety_check : Call Setup

    safety_check --> escalation : Injuries / Severe Crash
    safety_check --> verification : Safe / No Injuries

    state verification {
        [*] --> check_policy
        check_policy --> verified : Match
        check_policy --> callback_offer : Attempts >= 2
    }

    verification --> collecting_details : Verified Policy
    verification --> callback_offer : Verification Failed

    collecting_details --> clarifying : Malformed Reg Plate
    clarifying --> collecting_details : Reg Clarified

    collecting_details --> recommending_services : Fields Complete

    recommending_services --> completed : Complete Claim
    escalation --> completed : Emergency Advisory
    callback_offer --> completed : Callback Scheduled

    completed --> [*] : Persisted & Dispatched
