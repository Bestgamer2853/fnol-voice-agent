%% ----------------------------------------------------------------------------
%% 3. REQUEST FLOW & SEQUENCE DIAGRAM
%% ----------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Caller
    participant Retell as Retell AI Platform
    participant Server as Railway WS Server (server.ts)
    participant CM as ConversationManager
    participant Gemini as Gemini 2.5 Flash Lite
    participant Sheets as Google Sheets API
    participant Resend as Resend Email REST API

    Caller->>Retell: Initiates Phone / Web Call
    Retell->>Server: WS Connect (wss://fnol-voice-agent...)
    Server-->>Retell: WS Established

    Retell->>Server: call_details { call_id, metadata }
    Server->>CM: start()
    CM-->>Server: Initial State + Greeting
    Server-->>Retell: response { content: "Before we begin, are you safe?" }
    Retell-->>Caller: Plays Greeting Audio

    Caller->>Retell: "Yes, everyone is safe. Policy MMI-10234 Arjun Rao."
    Retell->>Server: response_required { response_id: 1, transcript }
    
    Server->>CM: handleUserMessage(state, message)
    CM->>Gemini: extract(userMessage, state) [SSE Stream]
    Gemini-->>CM: Extracted Slots JSON + Natural Response Text
    
    CM->>CM: Validate & Merge Slots
    CM->>CM: verifyPolicy("MMI-10234", "Arjun Rao") -> VERIFIED
    CM-->>Server: Updated State + Response Text

    Server-->>Retell: response { response_id: 1, content: "Thank you. When did it happen?", content_complete: true }
    Retell-->>Caller: Plays Spoken Audio

    Note over CM, Resend: ASYNCHRONOUS BACKGROUND PERSISTENCE (Non-Blocking)
    par Async Claim Persistence
        CM->>Sheets: log(claimRecord) -> Append Row
        Sheets-->>CM: 200 OK
    and Async Email Dispatch
        CM->>Resend: sendClaimConfirmation(claims@aurallon.com -> aurallonbiz@gmail.com)
        Resend-->>CM: 200 OK (Message ID: de32e35f...)
    end

%% ----------------------------------------------------------------------------
%% 4. CLAIM STATE MACHINE (FSM)
%% ----------------------------------------------------------------------------
stateDiagram-v2
    [*] --> safety_check : Call Initialized

    safety_check --> verification : Caller fine / safe
    safety_check --> escalation : Injury reported / Severe crash
    
    state verification {
        [*] --> check_policy
        check_policy --> verified : Policy + Name Match
        check_policy --> retry_failed : Mismatch (Attempt < 2)
        retry_failed --> check_policy : Retry prompt
        check_policy --> callback_offer : Mismatch (Attempt >= 2)
    }

    verification --> collecting_details : Verified
    verification --> callback_offer : Failed Verification (Max 2)

    collecting_details --> clarifying : Invalid reg / Ambiguous input
    clarifying --> collecting_details : Clarification received

    collecting_details --> recommending_services : All Required Fields Collected
    collecting_details --> escalation : Injury mentioned mid-call

    recommending_services --> completed : Towing / Garage selected or waived
    
    escalation --> completed : Emergency advisory delivered
    callback_offer --> completed : Callback scheduled

    completed --> [*] : Call Terminated (end_call: true)

